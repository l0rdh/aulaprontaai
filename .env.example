# Supabase (já existente)
VITE_SUPABASE_URL=seu_supabase_url
VITE_SUPABASE_PUBLISHABLE_KEY=sua_supabase_publishable_key
SUPABASE_URL=seu_supabase_url
SUPABASE_PUBLISHABLE_KEY=sua_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=sua_supabase_service_role_key

# Lovable AI (já existente)
LOVABLE_API_KEY=seu_lovable_api_key
LOVABLE_CRON_SECRET=seu_cron_secret
LOVABLE_CRON_SECRET_PREVIOUS=seu_cron_secret_previous

# Kiwify Integration (NOVO)
# Obtido em: Configurações > Integrações > API
KIWIFY_CLIENT_ID=seu_client_id
KIWIFY_CLIENT_SECRET=seu_client_secret
KIWIFY_ACCOUNT_ID=seu_account_id

# ID do produto/plano na Kiwify
# Encontrado na URL: https://app.kiwify.com.br/products/{PRODUCT_ID}
KIWIFY_PRODUCT_ID=seu_product_id

# Secret key da Kiwify para validar webhooks
# Encontrado em: Configurações > Webhooks > Secret Key
KIWIFY_WEBHOOK_SECRET=seu_webhook_secret

# URL da aplicação (para redirects)
APP_URL=http://localhost:5173
